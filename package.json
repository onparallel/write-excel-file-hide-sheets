{
  "name": "@onparallel/write-excel-file-hide-sheets",
  "version": "0.1.0",
  "description": "Hide sheets custom feature for write-excel-file",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onparallel/write-excel-file-hide-sheets.git"
  },
  "bugs": {
    "url": "https://github.com/onparallel/write-excel-file-hide-sheets/issues"
  },
  "homepage": "https://github.com/onparallel/write-excel-file-hide-sheets#readme",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:exports": "node scripts/check-exports.cjs && node scripts/check-exports.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples": "for f in examples/*.ts; do tsx \"$f\"; done",
    "examples:check": "bash scripts/check-examples-content.sh",
    "prepublishOnly": "pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "keywords": [
    "xlsx",
    "excel",
    "hide-sheets",
    "hidden",
    "write-excel-file"
  ],
  "author": "Santi Albo <santi@onparallel.com>",
  "license": "MIT",
  "peerDependencies": {
    "write-excel-file": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "write-excel-file": "^4.1.1"
  },
  "packageManager": "pnpm@12.9.1"
}
